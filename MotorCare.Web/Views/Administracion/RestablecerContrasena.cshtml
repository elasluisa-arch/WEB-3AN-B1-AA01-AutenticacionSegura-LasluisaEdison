@model AdminRestablecerContrasenaViewModel

@{
    ViewData["Title"] = "Cambiar contraseña de cuenta ficticia";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 account-panel p-4 p-md-5">
        <h1>Cambiar contraseña</h1>
        <p>Cuenta ficticia: <strong>@Model.Correo</strong></p>
        <p>La contraseña anterior no se puede consultar. Asigna una nueva que cumpla la política de seguridad.</p>

        <form asp-action="RestablecerContrasena" method="post">
            <input asp-for="Id" type="hidden" />
            <input asp-for="Correo" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="NuevaContrasena" class="form-label"></label>
                <input asp-for="NuevaContrasena" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NuevaContrasena" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmarContrasena" class="form-label"></label>
                <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar nueva contraseña</button>
            <a asp-action="Usuarios" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
