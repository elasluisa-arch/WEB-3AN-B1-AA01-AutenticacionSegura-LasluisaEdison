@model AdminCrearUsuarioViewModel

@{
    ViewData["Title"] = "Crear usuario";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 account-panel p-4 p-md-5">
        <h1>Crear usuario</h1>
        <p>La contraseña inicial debe cumplir la política de seguridad y debes comunicarla al usuario por un medio seguro.</p>

        <form asp-action="CrearUsuario" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="NombreCompleto" class="form-label"></label>
                <input asp-for="NombreCompleto" class="form-control" autocomplete="name" />
                <span asp-validation-for="NombreCompleto" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" autocomplete="email" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Rol" class="form-label"></label>
                <select asp-for="Rol" class="form-select">
                    <option value="Cliente">Cliente</option>
                    <option value="Administrador">Administrador</option>
                </select>
                <span asp-validation-for="Rol" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Contrasena" class="form-label"></label>
                <input asp-for="Contrasena" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Contrasena" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmarContrasena" class="form-label"></label>
                <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Crear usuario</button>
            <a asp-action="Usuarios" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
