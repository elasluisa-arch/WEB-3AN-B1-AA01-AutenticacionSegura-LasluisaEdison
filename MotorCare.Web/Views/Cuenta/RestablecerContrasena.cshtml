@model RestablecerContrasenaViewModel

@{
    ViewData["Title"] = "Crear contraseña nueva";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5 account-panel p-4 p-md-5">
        <h1 class="mb-4">Crear contraseña nueva</h1>
        <form asp-action="RestablecerContrasena" method="post">
            <input asp-for="Correo" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="NuevaContrasena" class="form-label"></label>
                <input asp-for="NuevaContrasena" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NuevaContrasena" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmarContrasena" class="form-label"></label>
                <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar contraseña</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
